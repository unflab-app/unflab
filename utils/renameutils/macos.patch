 static void
+edit_init(void)
+{
+    HistEvent ev;
+
+    el = el_init(program_name, stdin, stdout, stderr);
+    hist = history_init();
+    history(hist, &ev, H_SETSIZE, 100);
+    el_set(el, EL_HIST, history, hist);
+    el_set(el, EL_PROMPT, el_prompt);
+    el_set(el, EL_EDITOR, "emacs");
+    el_set(el, EL_SIGNAL, 1);
+    el_source(el, NULL);
+}
+
+static char *
+edit_line(const char *history_text, const char *text)
+{
+    HistEvent ev;
+    const char *line;
+    int count;
+
+    history(hist, &ev, H_ENTER, history_text);
+    el_push(el, text);
+    line = el_gets(el, &count);
+    if (line == NULL || count <= 0)
+        return NULL;
+    return xstrndup(line, strcspn(line, "\n"));
+}
